# Copia este archivo a .env.local para probar en local. En Vercel van en
# Settings → Environment Variables. Nunca subas claves al repositorio.

# Clave de Resend con permiso solo para enviar. Sin ella, en local el
# formulario solo escribe el encargo en la terminal, y en producción avisa
# de que todavía no está activo.
RESEND_API_KEY=

# A quién llegan los encargos. Si se deja vacío, a info@neumorstudio.com.
AVISOS_A=

# Remitente de los correos. El dominio tiene que estar verificado en Resend.
CORREO_DESDE=Edwin Jordan <info@neumorstudio.com>
